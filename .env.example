# Hoodey settings. Copy to .env for local runs; on Railway add these under Variables.
# Generated by `npm run env:example` from server/config.js. Empty values use the default.

# ── App ─────────────────────────────────────────────────────────
# Port the server listens on. Railway sets this for you; leave it empty there.
# PORT=3000
# production or development.
NODE_ENV=production
# Name shown in the header, page titles and alerts.
APP_NAME=Hoodey
# Short line used in page descriptions and link previews.
APP_TAGLINE="Eyes on every meme, before the market blinks."
# Public address of the site, e.g. https://hoodey.up.railway.app. Used for link previews.
PUBLIC_URL=
# How much the server logs. (debug | info | warn | error)
LOG_LEVEL=info

# ── Data ────────────────────────────────────────────────────────
# sample = built-in demo data, no keys needed. live = read Robinhood Chain (see DATA_SOURCE); any section that cannot load falls back to sample and says so. (sample | live)
DATA_MODE=sample
# Where live data comes from. chain = Hoodey reads Pons launches and trades itself over RH_RPC_URL and takes prices from DexPaprika (free, no keys). bitquery = the older Bitquery setup (needs BITQUERY_API_KEY and uses its points). (chain | bitquery)
DATA_SOURCE=chain
# How long API answers are cached on the server.
CACHE_TTL_SECONDS=30
# How often open pages refresh their data.
REFRESH_INTERVAL_SECONDS=60
# Timeout for calls to Bitquery and the RPC.
REQUEST_TIMEOUT_MS=10000

# ── Robinhood Chain ─────────────────────────────────────────────
# Robinhood Chain mainnet chain ID.
RH_CHAIN_ID=4663
# JSON-RPC endpoint for Robinhood Chain. With DATA_SOURCE=chain every launch and trade is read through it, so a private endpoint (QuickNode, Alchemy, Chainstack…) is steadier than the public default. [SECRET]
RH_RPC_URL=
# Block explorer base URL. When set, addresses link to it (e.g. <url>/address/0x…).
RH_EXPLORER_URL=
# Token page on Pons. The token address is appended, so every token links to <url>0x…. Leave empty to hide the Pons links.
PONS_TOKEN_URL=https://ponsfamily.com/launchpad/
# On start, how many hours of past launches and trades the chain indexer reads before going live. More hours = longer start and more RPC calls.
INDEX_BACKFILL_HOURS=6
# How many hours of launches and trades the indexer keeps in memory (deployer history, Copycat matches, launch clock).
INDEX_KEEP_HOURS=24
# How often the indexer reads new blocks. Lower = fresher data, more RPC calls.
INDEX_POLL_SECONDS=10
# Blocks per eth_getLogs call. Lower it if your RPC rejects large ranges.
INDEX_CHUNK_BLOCKS=10000
# DexPaprika API (free, no key). Gives stock token prices and ETH/USD.
DEXPAPRIKA_URL=https://api.dexpaprika.com
# DexPaprika network id for Robinhood Chain.
DEXPAPRIKA_NETWORK=robinhood
# How often stock token prices and ETH/USD are refreshed from DexPaprika.
PRICE_REFRESH_SECONDS=60
# Bitquery access token. Only used when DATA_SOURCE=bitquery. [SECRET]
BITQUERY_API_KEY=
# Bitquery GraphQL endpoint.
BITQUERY_ENDPOINT=https://streaming.bitquery.io/graphql
# Bitquery dataset for EVM queries. realtime works on every plan; archive and combined reach further back but need the Robinhood archive add-on. (realtime | archive | combined)
BITQUERY_DATASET=realtime
# Pons launch factory contract.
PONS_FACTORY_ADDRESS=0x7ed598bcef8bd9edd8c97a195c6d13f40801ec7e
# Pons router contract.
PONS_ROUTER_ADDRESS=0xe33e9e479df8802cb0866d5d05258bec4cf62948
# DATA_SOURCE=bitquery only: how long Bitquery results are reused before a background refresh.
LIVE_CACHE_SECONDS=120
# Minimum gap between Bitquery requests. Raise it (e.g. 4000) on plans with a low requests-per-minute limit.
BITQUERY_MIN_INTERVAL_MS=1500
# DATA_SOURCE=bitquery only: how many recent launches to pull per refresh.
LAUNCH_LIMIT=300

# ── Radar ───────────────────────────────────────────────────────
# Stock tokens to watch, comma separated, as TICKER:Name:tokenAddress. The address is needed for live price moves.
STOCK_TOKENS=TSLA:Tesla:0x322F0929c4625eD5bAd873c95208D54E1c003b2d,NVDA:Nvidia:0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC,AAPL:Apple:0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9,COIN:Coinbase:0x6330D8C3178a418788dF01a47479c0ce7CCF450b,MSTR:MicroStrategy:0xec262a75e413fAfD0dF80480274532C79D42da09,META:Meta:0xc0D6457C16Cc70d6790Dd43521C899C87ce02f35
# Words that tie a memecoin to a stock. TICKER=word|word;TICKER=word…
STOCK_KEYWORDS=TSLA=tesla|elon|musk|cyber|tsla|cybertruck;NVDA=nvidia|nvda|gpu|jensen|leather;AAPL=apple|aapl|iphone;COIN=coinbase|armstrong;MSTR=microstrategy|mstr|saylor;META=zuck|zuckerberg|facebook;GME=gamestop|gme|stonk|squeeze|kitty
# A stock token move of at least this many percent counts as a spike.
SPIKE_THRESHOLD_PCT=5
# Trades in the window needed before a move counts as a spike. Stops a single odd trade in a thin market from triggering the radar.
SPIKE_MIN_TRADES=3
# Default time window for the radar (1, 6 or 24 are offered in the UI).
SPIKE_LOOKBACK_HOURS=6
# Most themed tokens listed per spike.
RADAR_MAX_TOKENS=12
# Minutes of Pons trades the "Hot right now" board ranks.
TRENDING_WINDOW_MIN=60
# DATA_SOURCE=bitquery only: how many of the latest trades to scan for the "Hot right now" board.
TRENDING_TRADE_LIMIT=3000
# Most tokens shown on the "Hot right now" board.
TRENDING_MAX_ROWS=20

# ── Copycat Eye ─────────────────────────────────────────────────
# Name similarity (0–1) above which a token is flagged as a copy.
COPYCAT_NAME_THRESHOLD=0.7
# Image similarity (0–1) above which a token is flagged as a copy (used once image matching is enabled).
COPYCAT_IMAGE_THRESHOLD=0.8

# ── Token images ────────────────────────────────────────────────
# IPFS gateway for token logos (ipfs://… images). The public Filebase gateway works without an account; a Filebase dedicated gateway (https://<name>.myfilebase.com/ipfs/) is faster and can resize.
IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
# Extra query added to IPFS image URLs. Only for a Filebase dedicated gateway, e.g. img-width=128&img-height=128&img-fit=cover&img-format=webp. Leave empty on the public gateway (it refuses resizing).
IPFS_IMAGE_PARAMS=
# Memory the server may use to keep token logos.
IMAGE_CACHE_MB=64
# Largest logo file the server will fetch.
IMAGE_MAX_KB=3072
# Timeout for fetching one logo.
IMAGE_TIMEOUT_MS=8000

# ── Cabal Eye ───────────────────────────────────────────────────
# Seconds after launch that count as "early" buying.
CABAL_EARLY_SECONDS=60
# A first buy within this many seconds of launch is tagged Sniper.
CABAL_SNIPER_SECONDS=10
# Most early buyers looked at per launch.
CABAL_EARLY_MAX=25
# Cabal Map: two wallets are linked when they bought early in at least this many of the same launches.
CABAL_MIN_SHARED=3
# Cabal Map: smallest crew shown.
CABAL_MIN_MEMBERS=3
# Cabal Scan: most wallets listed.
CABAL_MAX_WALLETS=40
# Cabal Map: most crews listed.
CABAL_MAP_MAX=24

# ── Market Clock ────────────────────────────────────────────────
# Time zone of the exchange.
MARKET_TIMEZONE=America/New_York
# Pre-market start, HH:MM in exchange time.
MARKET_PREMARKET_OPEN=04:00
# Regular session open.
MARKET_OPEN=09:30
# Regular session close.
MARKET_CLOSE=16:00
# After-hours end.
MARKET_AFTERHOURS_CLOSE=20:00
# Full-day exchange holidays, YYYY-MM-DD, comma separated. Check the exchange calendar each year.
MARKET_HOLIDAYS=2026-11-26,2026-12-25,2027-01-01,2027-01-18,2027-02-15,2027-03-26,2027-05-31,2027-06-18,2027-07-05,2027-09-06,2027-11-25,2027-12-24

# ── Alerts ──────────────────────────────────────────────────────
# Bot or channel username without @. The "Get alerts" button opens t.me/<this>.
TELEGRAM_BOT_USERNAME=
# Bot token from @BotFather. Needed only for the server to post alerts. [SECRET]
TELEGRAM_BOT_TOKEN=
# Channel or group ID the server posts alerts to, e.g. @hoodey_alerts or -100…
TELEGRAM_CHAT_ID=
# Post spike alerts to Telegram.
ALERTS_ENABLED=false
# Only alert on stock moves of at least this many percent.
ALERT_MIN_MOVE_PCT=5
# Post a brief to Telegram before the regular session opens.
OPENING_BELL_BRIEF_ENABLED=false
# Minutes before the open to post the brief.
OPENING_BELL_MINUTES_BEFORE=30

# ── Links ───────────────────────────────────────────────────────
# X (Twitter) profile URL.
LINK_X=
# Telegram community URL.
LINK_TELEGRAM=
# Docs URL.
LINK_DOCS=
# Where the "Vote on the roadmap" button goes. Hidden when empty.
ROADMAP_VOTE_URL=
# $HOODEY contract address, shown in the footer when set.
TOKEN_CONTRACT_ADDRESS=
# Link to buy $HOODEY, shown in the footer when set.
TOKEN_BUY_URL=

# ── Theme ───────────────────────────────────────────────────────
# Main accent color (buttons, gauges, bars).
THEME_ACCENT=#00C805
# Darker accent used for text and chart lines on white.
THEME_ACCENT_INK=#078A33
# Page background.
THEME_BG=#F7FAF8
# Animated 3D dot field behind the pages.
BG_ANIMATION_ENABLED=true

# ── Features ────────────────────────────────────────────────────
# Show Stock → Meme Radar.
FEATURE_RADAR=true
# Show Copycat Eye.
FEATURE_COPYCAT=true
# Show Cabal Eye (Cabal Scan and Cabal Map).
FEATURE_CABAL=true
# Show X-Ray (Death Clock for tokens, Wallet X-Ray for wallets).
FEATURE_XRAY=true
# Show Market Clock.
FEATURE_CLOCK=true
# Show Narrative Family Tree.
FEATURE_FAMILY=true
# Show Roadmap.
FEATURE_ROADMAP=true
# Show the Wallet Watch box on the radar.
FEATURE_WALLET_WATCH=true

# ── Security ────────────────────────────────────────────────────
# API requests allowed per visitor IP per minute.
RATE_LIMIT_PER_MINUTE=120
# Other sites allowed to call the API, comma separated. Empty = same site only.
CORS_ORIGINS=
# Read the visitor IP from X-Forwarded-For (correct behind Railway).
TRUST_PROXY=true
