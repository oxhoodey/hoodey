# HoodEye settings. Copy to .env for local runs; on Railway add these under Variables.
# Generated by `npm run env:example` from server/config.js. Empty values use the default.

# ── App ─────────────────────────────────────────────────────────
# Port the server listens on. Railway sets this for you; leave it empty there.
# PORT=3000
# production or development.
NODE_ENV=production
# Name shown in the header, page titles and alerts.
APP_NAME=HoodEye
# Short line used in page descriptions and link previews.
APP_TAGLINE="Eyes on every meme, before the market blinks."
# Public address of the site, e.g. https://hoodeye.up.railway.app. Used for link previews.
PUBLIC_URL=
# How much the server logs. (debug | info | warn | error)
LOG_LEVEL=info

# ── Data ────────────────────────────────────────────────────────
# sample = built-in demo data, no keys needed. live = read Robinhood Chain through Bitquery and RPC; any section that cannot load falls back to sample and says so. (sample | live)
DATA_MODE=sample
# How long API answers are cached on the server.
CACHE_TTL_SECONDS=30
# How often open pages refresh their data.
REFRESH_INTERVAL_SECONDS=60
# Timeout for calls to Bitquery and the RPC.
REQUEST_TIMEOUT_MS=10000

# ── Robinhood Chain ─────────────────────────────────────────────
# Robinhood Chain mainnet chain ID.
RH_CHAIN_ID=4663
# JSON-RPC endpoint for Robinhood Chain. Used to read token name and symbol in Copycat scans. [SECRET]
RH_RPC_URL=
# Block explorer base URL. When set, addresses link to it (e.g. <url>/address/0x…).
RH_EXPLORER_URL=
# Bitquery access token. Needed for live launches, trades and deployer history. [SECRET]
BITQUERY_API_KEY=
# Bitquery GraphQL endpoint.
BITQUERY_ENDPOINT=https://streaming.bitquery.io/graphql
# Bitquery dataset for EVM queries. archive and combined reach further back. (realtime | archive | combined)
BITQUERY_DATASET=combined
# Pons launch factory contract.
PONS_FACTORY_ADDRESS=0x7ed598bcef8bd9edd8c97a195c6d13f40801ec7e
# Pons router contract.
PONS_ROUTER_ADDRESS=0xe33e9e479df8802cb0866d5d05258bec4cf62948
# How many recent launches to pull per refresh in live mode.
LAUNCH_LIMIT=300

# ── Radar ───────────────────────────────────────────────────────
# Stock tokens to watch, comma separated, as TICKER:Name:tokenAddress. The address is needed for live price moves.
STOCK_TOKENS=TSLA:Tesla:,NVDA:Nvidia:,COIN:Coinbase:,GME:GameStop:,AAPL:Apple:
# Words that tie a memecoin to a stock. TICKER=word|word;TICKER=word…
STOCK_KEYWORDS=TSLA=tesla|elon|musk|cyber|rocket|tsla|giga;NVDA=nvidia|nvda|gpu|chip|jensen|leather;COIN=coinbase|coin|base|armstrong;GME=gamestop|gme|stonk|squeeze|diamond|ape|kitty;AAPL=apple|aapl|iphone|tim
# A stock token move of at least this many percent counts as a spike.
SPIKE_THRESHOLD_PCT=5
# Default time window for the radar (1, 6 or 24 are offered in the UI).
SPIKE_LOOKBACK_HOURS=6
# Most themed tokens listed per spike.
RADAR_MAX_TOKENS=12

# ── Copycat Eye ─────────────────────────────────────────────────
# Name similarity (0–1) above which a token is flagged as a copy.
COPYCAT_NAME_THRESHOLD=0.7
# Image similarity (0–1) above which a token is flagged as a copy (used once image matching is enabled).
COPYCAT_IMAGE_THRESHOLD=0.8
# Gateway used to show token logos stored on IPFS.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── Market Clock ────────────────────────────────────────────────
# Time zone of the exchange.
MARKET_TIMEZONE=America/New_York
# Pre-market start, HH:MM in exchange time.
MARKET_PREMARKET_OPEN=04:00
# Regular session open.
MARKET_OPEN=09:30
# Regular session close.
MARKET_CLOSE=16:00
# After-hours end.
MARKET_AFTERHOURS_CLOSE=20:00
# Full-day exchange holidays, YYYY-MM-DD, comma separated. Check the exchange calendar each year.
MARKET_HOLIDAYS=2026-11-26,2026-12-25,2027-01-01,2027-01-18,2027-02-15,2027-03-26,2027-05-31,2027-06-18,2027-07-05,2027-09-06,2027-11-25,2027-12-24

# ── Alerts ──────────────────────────────────────────────────────
# Bot or channel username without @. The "Get alerts" button opens t.me/<this>.
TELEGRAM_BOT_USERNAME=
# Bot token from @BotFather. Needed only for the server to post alerts. [SECRET]
TELEGRAM_BOT_TOKEN=
# Channel or group ID the server posts alerts to, e.g. @hoodeye_alerts or -100…
TELEGRAM_CHAT_ID=
# Post spike alerts to Telegram.
ALERTS_ENABLED=false
# Only alert on stock moves of at least this many percent.
ALERT_MIN_MOVE_PCT=5
# Post a brief to Telegram before the regular session opens.
OPENING_BELL_BRIEF_ENABLED=false
# Minutes before the open to post the brief.
OPENING_BELL_MINUTES_BEFORE=30

# ── Links ───────────────────────────────────────────────────────
# X (Twitter) profile URL.
LINK_X=
# Telegram community URL.
LINK_TELEGRAM=
# Docs URL.
LINK_DOCS=
# Where the "Vote on the roadmap" button goes. Hidden when empty.
ROADMAP_VOTE_URL=
# $HOODEYE contract address, shown in the footer when set.
TOKEN_CONTRACT_ADDRESS=
# Link to buy $HOODEYE, shown in the footer when set.
TOKEN_BUY_URL=

# ── Theme ───────────────────────────────────────────────────────
# Main accent color (buttons, gauges, bars).
THEME_ACCENT=#00C805
# Darker accent used for text and chart lines on white.
THEME_ACCENT_INK=#078A33
# Page background.
THEME_BG=#F3F8F4
# Animated 3D dot field behind the pages.
BG_ANIMATION_ENABLED=true

# ── Features ────────────────────────────────────────────────────
# Show Stock → Meme Radar.
FEATURE_RADAR=true
# Show Copycat Eye.
FEATURE_COPYCAT=true
# Show Market Clock.
FEATURE_CLOCK=true
# Show Narrative Family Tree.
FEATURE_FAMILY=true
# Show Roadmap.
FEATURE_ROADMAP=true
# Show the Wallet Watch box on the radar.
FEATURE_WALLET_WATCH=true

# ── Security ────────────────────────────────────────────────────
# API requests allowed per visitor IP per minute.
RATE_LIMIT_PER_MINUTE=120
# Other sites allowed to call the API, comma separated. Empty = same site only.
CORS_ORIGINS=
# Read the visitor IP from X-Forwarded-For (correct behind Railway).
TRUST_PROXY=true
